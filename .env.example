# ─────────────────────────────────────────────────────────────
# Marian Barnow Spiritual Training — client portal
# Copy this file to .env.local (local) or paste the values into
# Vercel → Project → Settings → Environment Variables.
# If the Supabase values are left empty the app runs in DEMO MODE
# with sample content and no real logins.
# ─────────────────────────────────────────────────────────────

# Public address of the app (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://portal.marianbarnow.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys, and the webhook signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Momence (Dashboard → Apps & Integrations → Developer API)
# Use a staff login of your own studio account for USERNAME/PASSWORD.
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
# Optional: only show classes at this Momence location id
MOMENCE_LOCATION_ID=
# How many days ahead the class calendar shows
MOMENCE_DAYS_AHEAD=60

# Price used when no row in the class_pricing table matches a class name (in cents)
DEFAULT_CLASS_PRICE_CENTS=2000
DEFAULT_CURRENCY=eur

# Shown on booking confirmations and in calendar files
STUDIO_ADDRESS=48 Mount Street Upper, Dublin 2
